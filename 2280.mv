# 2280 - printf
# Read an ASCII character and output its decimal ASCII code
# Strategy: Store pre-computed decimal digits for each value in memory

A<I         # Read character into A

# Store mapping: mem[256+V] -> mem[256+V+0] = hundreds, +1 = tens, +2 = ones
# But memory is only 512 bytes (0-511)... actually it's 65536 per interpreter.c

# Simpler: for each value 0-127, store the three digits
# Use memory layout:
#   mem[300 + V] = hundreds digit + '0'
#   mem[400 + V] = tens digit + '0'
#   mem[500 + V] = ones digit + '0'

# But I can't initialize all 128 values efficiently in mov language
#
# Alternative: Use direct computation with subtraction loops
# Since program loops automatically, I can use the loop counter

# Actually, let me think about this problem differently:
# The hint says "O<0 is treated as not outputting any character"
# So I can output hundreds (if >0), tens (if >0 or hundreds>0), ones (always)

# For value V:
# If V >= 100: output '1', V = V - 100
# For tens digit: count subtractions of 10
# For ones digit: output remaining

# Store the value in a memory location and work with it
[100]<A     # mem[100] = A (original value)

# Compute hundreds: if A >= 100, output '1' and subtract 100
# Use lookup: mem[0-99] = 0, mem[100-127] = 1
[0]<0
[100]<1
[101]<1
[102]<1
[103]<1
[104]<1
[105]<1
[106]<1
[107]<1
[108]<1
[109]<1
[110]<1
[111]<1
[112]<1
[113]<1
[114]<1
[115]<1
[116]<1
[117]<1
[118]<1
[119]<1
[120]<1
[121]<1
[122]<1
[123]<1
[124]<1
[125]<1
[126]<1
[127]<1

B<[A]       # B = 1 if A >= 100, else 0
C<B         # Copy to C
